<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.smarthouse.mapper.FurnitureMapper">

    <resultMap id="BaseResultMap" type="com.example.smarthouse.model.entity.Furniture">
            <id property="id" column="id" />
            <result property="furnitureName" column="furniture_name" />
            <result property="positionX" column="position_x" />
            <result property="positionY" column="position_y" />
            <result property="width" column="width" />
            <result property="height" column="height" />
            <result property="roomId" column="room_id" />
            <result property="fileName" column="file_name" />
    </resultMap>

    <sql id="Base_Column_List">
        id,furniture_name,position_x,position_y,width,height,
        room_id,file_name
    </sql>
</mapper>
